{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "triage247ng",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET"
    }
  ],
  "vars": {
    "TRIAGENG_ENVIRONMENT": "production",
    "TRIAGENG_LOCAL_DEV": "false"
  }
}
