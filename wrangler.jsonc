{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "triage247ng",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "triage247ng-db",
      "database_id": "5e1b67b0-ffab-49fc-8182-110ca4e62d7b",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "EVIDENCE",
      "id": "f731aca42a394c47ab0b6317faa63ce3"
    }
  ],
  "vars": {
    "TRIAGENG_ENVIRONMENT": "production",
    "TRIAGENG_LOCAL_DEV": "false",
    "TRIAGENG_TRUST_CLOUDFLARE_ACCESS": "false",
    "TRIAGENG_ADMIN_EMAIL": "atamisaiah@gmail.com"
  }
}
